{
    "$schema": "../config/settings.schema.json",
    "+lsp": {
        "nimlangserver": null,

        "clangd.command": ["clangd", "--offset-encoding=utf-8", "--background-index", "--limit-results=100", "--limit-references=2000", "--clang-tidy"],

        "+rust-analyzer": {
            "rust-analyzer": {
                "linkedProjects": ["temp/rust_test/Cargo.toml"]
            }
        }
    },

    "+snippets": {
        "+nim": {
            "Print to console": {
                "scope": "nim",
                "prefix": "log",
                "body": [
                    "log lvl${1:Info}, &\"[${TM_FILENAME/(.*)\\..*$/${1:/capitalize}/}] $2\""
                ]
            },
            "try": {
                "scope": "nim",
                "prefix": "try",
                "body": [
                    "try:",
                    "  ${1:discard}",
                    "except ${2:CatchableError}:",
                    "  ${0:discard}"
                ]
            },
            "tryef": {
                "scope": "nim",
                "prefix": "tryef",
                "body": [
                    "try:",
                    "  ${1:discard}",
                    "except ${2:CatchableError}:",
                    "  ${3:discard}",
                    "finally:",
                    "  ${0:discard}"
                ]
            },
            "tryf": {
                "scope": "nim",
                "prefix": "tryf",
                "body": [
                    "try:",
                    "  ${1:discard}",
                    "finally:",
                    "  ${0:discard}"
                ]
            },
            "Pragma": {
                "scope": "nim",
                "prefix": "pra",
                "body": [
                    "{{.$0.}"
                ]
            },
            "Procedure": {
                "scope": "nim",
                "prefix": "proc",
                "body": [
                    "proc ${1:name}($2)$3 =",
                    "  ${0:discard}"
                ]
            },
            "Async procedure": {
                "scope": "nim",
                "prefix": "proca",
                "body": [
                    "proc ${1:name}($2)$3 {.async.} =",
                    "  ${0:discard}"
                ]
            },
            "For loop": {
                "scope": "nim",
                "prefix": "for",
                "body": [
                    "for ${1:it} in ${2:items}:",
                    "  ${0:discard}"
                ]
            },
            "While loop": {
                "scope": "nim",
                "prefix": "whl",
                "body": [
                    "while ${1:true}:",
                    "  ${0:discard}"
                ]
            },
            "If": {
                "scope": "nim",
                "prefix": "if",
                "body": [
                    "if ${1:true}:",
                    "  ${0:discard}"
                ]
            },
            "Elif": {
                "scope": "nim",
                "prefix": "elif",
                "body": [
                    "elif ${1:true}:",
                    "  ${0:discard}"
                ]
            },
            "If+Else": {
                "scope": "nim",
                "prefix": "ife",
                "body": [
                    "if ${1:true}:",
                    "  ${2:discard}",
                    "else:",
                    "  ${0:discard}"
                ]
            }
        }
    },

    "+debugger": {
        "+type": {
            "lldb-dap": {
                "connection": "stdio",
                "path": "lldb-dap",
                "args": []
            },
            "lldb-dap-tcp-launch": {
                "connection": "tcp",
                "path": "D:/llvm/bin/lldb-dap.exe"
            },
            "lldb": {
                "connection": "tcp",
                "path": "C:/llvm/build_release/RelWithDebInfo/bin/lldb-dap.exe"
            },
            "lldb-dap-tcp": {
                "connection": "tcp",
                "port": 5678
            },
            "lldb-dap-debug-tcp-launch": {
                "connection": "tcp",
                "path": "C:/llvm/build_lldb/Debug/bin/lldb-dap.exe"
            },
            "lldb-debug": {
                "connection": "tcp",
                "path": "C:/llvm/build_lldb/Debug/bin/lldb-dap.exe"
            },
            "lldb-port": {
                "connection": "tcp",
                "port": 5678
            },
            "lldb-dap2": {}
        },
        "+configuration": {
            "nev": {
                "type": "lldb-dap",
                "request": "launch",
                "program": "nevd",
                "args": ["-s:linux.nev-session"]
            }
        }
    },

    "+builds": {
        "nev-modules": {
            "description": "Build Nev modules",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nim ./tools/nev_build.nims modules --nuigi-dir:C:/dev/nuigi",
            "group": "build-run"
        },
        "nev-modules-force": {
            "description": "Build Nev modules (force)",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nim ./tools/nev_build.nims modules-f --nuigi-dir:C:/dev/nuigi",
            "group": "build-run"
        },
        "nev-modules-rebuild-dependents": {
            "description": "Build Nev modules (rebuild dependents)",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "./bin/build.exe --rebuild-dependents",
            "group": "build-run"
        },
        "nev-dynamic": {
            "description": "Build Nev dynamic",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nim ./tools/nev_build.nims build-dynamic --nuigi-dir:C:/dev/nuigi",
            "group": "build-run"
        },
        "nev-static": {
            "description": "Build Nev static",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nim ./tools/nev_build.nims build-static --nuigi-dir:C:/dev/nuigi",
            "group": "build-run"
        },
        "nev-perf": {
            "description": "Build Nev profiled",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nim ./tools/nev_build.nims build-perf --nuigi-dir:C:/dev/nuigi",
            "group": "build-run"
        },
        "wasm-module": {
            "description": "Build wasm module",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nimble buildCustomWasmModule",
            "group": "build-run"
        },
        "nimony-check": {
            "description": "Check nimony main",
            "setup": "C:/dev/emsdk/emsdk.ps1 activate",
            "command": "nimony check src/desktop_main_nimony.nim",
            "group": "build-run"
        },
        "settings-generator": {
            "description": "Build settings generator",
            "command": "nim c -o:settings_generator.exe ./tools/settings_generator.nim",
            "group": "build-run"
        },
        "settings": {
            "description": "Generate settings",
            "command": "./settings_generator.exe",
            "group": "build-run"
        },
        "ctags-nev": {
            "description": "Build Nev CTags",
            "command": "ntagger -f ./tags -p src patches modules",
            "group": "build-run"
        },
        "ctags-deps": {
            "description": "Build deps CTags",
            "command": "ntagger -f ./deps/tags -e tests -e experiments -e xio -e bearssl -e bitty -e c2nim -e crunchy -e docopt -e flatty -e graphemes -e httputils -e libssh2 -e mddoc -e nimgen -e opengl -e segmentation -e ssh2 -e supersnappy -e unicodedb -e unicodeplus -e unittest2 -e winim -e xio -e xflywind -e npeg -p deps",
            "group": "build-run"
        },
        "run-nev": {
            "kind": "run",
            "description": "Run Nev",
            "command": "nev --monitor:1",
            "group": "build-run"
        },
        "debug-nev-raddbg": {
            "kind": "run",
            "description": "Debug Nev (raddbg)",
            "command": "C:/Users/nimao/Downloads/raddbg/raddbg.exe --ipc run",
            "group": "build-run"
        }
    },

    "x+startup-commands": [
        ".lsp-log-server-debug true",
        ".lsp-log-verbose true"
    ],

    // "+wasm-plugin-post-load-commands": [
    //     "load-vscode-debugger-config \".vscode/launch.json\""
    // ]
}